# ===========================================================================
# Multilingual file for the TOS 7 Docker application "snapotterdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "SnapOtter"
auth         = "SnapOtter"
version      = "@@VERSION@@"
descript     = "SnapOtter is a self-hosted image toolkit: convert, resize, compress, crop and batch-process photos in the browser while the files stay on your NAS. This package runs the official Docker Hub image with its own PostgreSQL database and Redis cache as non-root containers; all data lives in the application data folder."
release_note = "1. First release."
important    = "First run: open the web UI and log in with the default admin/admin, then change the password immediately. The stack contains three containers (app, PostgreSQL, Redis) that are only reachable from the app. Data lives under /Volume1/DockerAppData/snapotterdocker/ and survives restarts and updates. Needs DockerEngine; configure a registry mirror if Docker Hub is unreachable. Back up the application data folder before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "SnapOtter"
auth         = "SnapOtter"
version      = "@@VERSION@@"
descript     = "截图与图片美化工具，支持模板与标注。"
release_note = "1. First release."
important    = "首次使用请打开网页完成初始化。数据保存在 DockerAppData/snapotterdocker，重启和升级不会丢失。容器以 uid 1000 运行，挂载目录需对该用户可读。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。卸载并删除数据前请备份。局域网内为 HTTP。"

